    "description": "Greenstand TreeTracker API: manages the flow of field-collected tree plantings from grower-submitted captures through spatial matching into verified trees, with tagging, grower accounts, S3 image storage, and an asynchronous domain-event backbone over RabbitMQ.",
    "analyzedAt": "2026-09-02T21:42:21.471896Z",
    "gitCommitHash": "85258c8ee5f1cae66a3de3e7d8b3b37faf1ae35c"
  },
  "nodes": [
    {
      "id": "domain:capture-management",
      "type": "domain",
      "name": "Capture Management",
      "summary": "Handles ingestion and lifecycle of captures, the field photos submitted when a grower plants a tree. Validates and persists capture records, then raises capture-created domain events for downstream matching and verification.",
      "tags": [
        "captures",
        "ingestion",
        "field-data",
        "validation"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Capture",
          "CaptureTag",
          "DomainEvent"
        ],
        "businessRules": [
          "A capture must pass Joi validation before persistence",
          "Capture writes run inside a DB transaction",
          "Creating a capture raises a capture-created domain event"
        ],
        "crossDomainInteractions": [
          "Publishes capture-created events to Domain Events & Messaging",
          "Feeds captures into Tree Management for potential-match resolution",
          "Associates tags via Tagging"
        ]
      }
    },
    {
      "id": "domain:tree-management",
      "type": "domain",
      "name": "Tree Management",
      "summary": "Manages verified trees (matched plantings) including CRUD, spatial potential-match resolution between captures and trees via PostGIS, and legacy-tree approval against the legacy TreeTracker API.",
      "tags": [
        "trees",
        "matching",
        "postgis",
        "verification"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Tree",
          "TreeTag"
        ],
        "businessRules": [
          "Potential matches resolve captures to trees using spatial (PostGIS) queries",
          "Tree creation raises a tree-created domain event",
          "Legacy trees are approved through an authenticated external API call"
        ],
        "crossDomainInteractions": [
          "Consumes captures from Capture Management for matching",
          "Publishes tree-created events to Domain Events & Messaging",
          "Associates tags via Tagging"
        ]
      }
    },
    {
      "id": "domain:grower-account-management",
