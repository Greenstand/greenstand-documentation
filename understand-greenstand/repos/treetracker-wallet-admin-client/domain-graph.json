  "nodes": [
    {
      "id": "domain:authentication-access",
      "type": "domain",
      "name": "Authentication & Access",
      "summary": "Controls who can use the admin panel. Handles the login form, credential validation, JWT token persistence, route protection and session expiry, including automatic redirect on unauthorized API responses.",
      "tags": [
        "authentication",
        "authorization",
        "session",
        "security"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Credentials",
          "AuthToken (JWT)",
          "Wallet identity",
          "API key"
        ],
        "businessRules": [
          "Wallet name, password and API key are all required to log in",
          "Token and current wallet persist in localStorage; API key uses secure storage",
          "Protected routes render only when a valid session exists",
          "A 401 response clears the session and redirects to login"
        ],
        "crossDomainInteractions": [
          "Supplies the auth token that every wallet, transfer and trust API call sends"
        ]
      }
    },
    {
      "id": "domain:wallet-management",
      "type": "domain",
      "name": "Wallet Management",
      "summary": "Lists the owner's wallets, opens a single wallet's detail view with token and pending-transfer stats, and creates new managed (sub) wallets. Wallets are the core account entity that all other domains act upon.",
      "tags": [
        "wallets",
        "accounts",
        "crud",
        "data-table"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "Wallet",
          "Managed wallet",
          "Wallet balance",
          "Pending transfer count"
        ],
        "businessRules": [
          "A wallet list is paginated, sorted and scoped to the owner",
          "A new managed wallet name must pass client-side validation and be unique",
          "A wallet detail view combines the wallet record with its pending transfers"
        ],
        "crossDomainInteractions": [
          "Provides the wallet records and balances used by token transfers",
          "Is the target entity updated by wallet customization"
        ]
      }
    },
    {
      "id": "domain:token-transfers",
      "type": "domain",
      "name": "Token Transfers",
      "summary": "Moves tokens between wallets and manages the resulting transfer records. Covers sending tokens to trusted and untrusted wallets with amount validation and confirmation, plus listing, filtering, accepting, declining and cancelling transfers.",
      "tags": [
        "transfers",
        "tokens",
        "payments",
        "workflow"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Transfer",
          "Pending transfer",
          "Token amount",
          "Sender wallet",
          "Receiver wallet"
        ],
        "businessRules": [
          "Available tokens equal in-wallet balance minus pending transfers",
          "A transfer amount must be a positive number within the available balance",
          "Sending to a trusted wallet completes directly; sending to an untrusted wallet creates a pending transfer",
          "Only the receiver may accept or decline a pending transfer; only the sender may cancel it"
        ],
        "crossDomainInteractions": [
          "Reads wallet balances and can create a wallet inline during a send",
          "Branches on trusted versus untrusted status defined by trust relationships"
        ]
      }
    },
    {
      "id": "domain:trust-relationships",
      "type": "domain",
      "name": "Trust Relationships",
      "summary": "Establishes and manages trust links between wallets that permit direct token transfers. Handles requesting a new relationship, listing and filtering relationships, and accepting, declining or deleting them.",
      "tags": [
        "trust-relationship",
        "permissions",
        "wallets",
        "workflow"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Trust relationship",
          "Relationship request",
          "Relationship type",
          "Trusted wallet"
        ],
        "businessRules": [
          "A relationship is created between a source and target wallet with a chosen relationship type",
          "A requested relationship stays pending until the counterparty accepts or declines it",
          "Either party may delete an existing relationship"
        ],
        "crossDomainInteractions": [
          "Defines which wallets count as trusted for direct token transfers",
          "Selects among the owner's wallets when creating a relationship"
        ]
      }
    },
